# Secrets and credentials — never commit these.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
/secrets/
credentials.json

# Go build artifacts.
#
# Binary names are anchored with a leading slash on purpose. A bare pattern
# like `api-gateway` matches at EVERY level, so it silently excluded the whole
# services/api-gateway/ directory tree from the repository rather than just the
# compiled binary. Bare service names cost us 34 source files before this was
# caught - keep the slashes.
/bin/
/build/
/dist/
/anguli
/api-gateway
/biometric-service
/access-policy-service
/edge-gateway-service
*.exe
*.test
*.out

# Coverage and profiling
coverage.out
coverage.html
*.prof
*.cpuprofile
*.memprofile

# Chaos / fuzz corpus caches
testdata/fuzz/
*.cache

# Node / frontend
node_modules/
web/node_modules/
npm-debug.log*
yarn-error.log*

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local runtime state
/tmp/
*.pid
*.log